# ─────────────────────────────────────────────────────────────────────────────
# Pollution Intelligence Platform — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite file in the backend directory (no extra setup needed)
DATABASE_URL=sqlite:///./pollution_platform.db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=pollution-platform-secret-key-2026
# Token expiry in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# ── IBM watsonx / Granite ─────────────────────────────────────────────────────
WATSONX_API_KEY=nbOtVWHaS-8p2LqOif7y-ALy7-o0x8bdIYH86-DvnO0p
WATSONX_AI_URL=https://api.au-syd.watson-orchestrate.cloud.ibm.com/instances/dd476567-27cb-437c-8f2b-dda686659643
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── App Settings ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Optional: SMTP for alert emails ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password
ALERT_FROM=alerts@yourdomain.com
